# Friendly Companion — copy this file to `.env` and fill in your own key.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used by default. Must be a model enabled for your API account.
GEMINI_MODEL=gemini-3.5-flash

# Comma separated fallbacks tried in order when the configured model is
# unavailable for the account (404 / unsupported model).
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-flash-latest

# Local server binding. Keep 127.0.0.1 unless you secured the app.
COMPANION_HOST=127.0.0.1
COMPANION_PORT=8000

# Upload limit per attachment, in megabytes.
MAX_UPLOAD_MB=20

# How many previous messages are sent to the model as context.
MAX_HISTORY_MESSAGES=40

# Seconds to wait for the model to send something before giving up on it and
# moving to the next model in the fallback list. 5-600.
GEMINI_TIMEOUT=45

# Diagnostic log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
